rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate: Verify parent user profile exists and belongs to the authenticated owner
    function hasValidParentProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Blueprint Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'fullName', 'age', 'gender', 'heightCm', 'targetWeightKg',
          'bloodType', 'primaryDoctor', 'emergencyContact', 'dailyCalorieGoal',
          'dailyWaterGoalMl', 'dailyStepsGoal', 'dailySleepGoalHours',
          'waterIntakeMl', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'fullName', 'age', 'gender', 'heightCm', 'targetWeightKg',
          'bloodType', 'primaryDoctor', 'emergencyContact', 'dailyCalorieGoal',
          'dailyWaterGoalMl', 'dailyStepsGoal', 'dailySleepGoalHours',
          'waterIntakeMl', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.age is number && data.age >= 1 && data.age <= 130 &&
        data.gender is string && (data.gender == 'male' || data.gender == 'female') &&
        data.heightCm is number && data.heightCm >= 40 && data.heightCm <= 260 &&
        data.targetWeightKg is number && data.targetWeightKg >= 20 && data.targetWeightKg <= 300 &&
        data.bloodType is string && data.bloodType.size() >= 1 && data.bloodType.size() <= 10 &&
        data.primaryDoctor is string && data.primaryDoctor.size() >= 1 && data.primaryDoctor.size() <= 150 &&
        data.emergencyContact is string && data.emergencyContact.size() >= 1 && data.emergencyContact.size() <= 150 &&
        data.dailyCalorieGoal is number && data.dailyCalorieGoal >= 500 && data.dailyCalorieGoal <= 10000 &&
        data.dailyWaterGoalMl is number && data.dailyWaterGoalMl >= 250 && data.dailyWaterGoalMl <= 10000 &&
        data.dailyStepsGoal is number && data.dailyStepsGoal >= 500 && data.dailyStepsGoal <= 100000 &&
        data.dailySleepGoalHours is number && data.dailySleepGoalHours >= 1 && data.dailySleepGoalHours <= 24 &&
        data.waterIntakeMl is number && data.waterIntakeMl >= 0 && data.waterIntakeMl <= 20000 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    function isValidVitalRecord(data, userId, vitalId) {
      return data.keys().hasAll([
          'id', 'userId', 'date', 'time', 'systolic', 'diastolic', 'heartRate',
          'spo2', 'bloodGlucose', 'glucoseContext', 'weightKg', 'temperatureC',
          'sleepHours', 'steps', 'deviceSource', 'note', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'date', 'time', 'systolic', 'diastolic', 'heartRate',
          'spo2', 'bloodGlucose', 'glucoseContext', 'weightKg', 'temperatureC',
          'sleepHours', 'steps', 'deviceSource', 'note', 'updatedAt'
        ]) &&
        data.id is string && data.id == vitalId && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 16 &&
        data.systolic is number && data.systolic >= 60 && data.systolic <= 260 &&
        data.diastolic is number && data.diastolic >= 35 && data.diastolic <= 160 &&
        data.heartRate is number && data.heartRate >= 30 && data.heartRate <= 240 &&
        data.spo2 is number && data.spo2 >= 50 && data.spo2 <= 100 &&
        data.bloodGlucose is number && data.bloodGlucose >= 30 && data.bloodGlucose <= 600 &&
        data.glucoseContext is string && (data.glucoseContext == 'fasting' || data.glucoseContext == 'post_meal') &&
        data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 300 &&
        data.temperatureC is number && data.temperatureC >= 34 && data.temperatureC <= 43 &&
        data.sleepHours is number && data.sleepHours >= 0 && data.sleepHours <= 24 &&
        data.steps is number && data.steps >= 0 && data.steps <= 150000 &&
        data.deviceSource is string && data.deviceSource.size() >= 1 && data.deviceSource.size() <= 80 &&
        data.note is string && data.note.size() <= 500 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    function isValidMealEntry(data, userId, mealId) {
      return data.keys().hasAll([
          'id', 'userId', 'date', 'time', 'mealType', 'foodName',
          'calories', 'proteinG', 'carbsG', 'fatG', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'date', 'time', 'mealType', 'foodName',
          'calories', 'proteinG', 'carbsG', 'fatG', 'updatedAt'
        ]) &&
        data.id is string && data.id == mealId && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 16 &&
        data.mealType is string && (
          data.mealType == 'breakfast' || data.mealType == 'lunch' ||
          data.mealType == 'dinner' || data.mealType == 'snack'
        ) &&
        data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 150 &&
        data.calories is number && data.calories >= 0 && data.calories <= 10000 &&
        data.proteinG is number && data.proteinG >= 0 && data.proteinG <= 1000 &&
        data.carbsG is number && data.carbsG >= 0 && data.carbsG <= 1000 &&
        data.fatG is number && data.fatG >= 0 && data.fatG <= 1000 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    function isValidWorkoutEntry(data, userId, workoutId) {
      return data.keys().hasAll([
          'id', 'userId', 'date', 'activityName', 'durationMinutes',
          'caloriesBurned', 'intensity', 'avgHeartRate', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'date', 'activityName', 'durationMinutes',
          'caloriesBurned', 'intensity', 'avgHeartRate', 'updatedAt'
        ]) &&
        data.id is string && data.id == workoutId && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 20 &&
        data.activityName is string && data.activityName.size() >= 1 && data.activityName.size() <= 120 &&
        data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 1440 &&
        data.caloriesBurned is number && data.caloriesBurned >= 1 && data.caloriesBurned <= 15000 &&
        data.intensity is string && (
          data.intensity == 'low' || data.intensity == 'moderate' || data.intensity == 'high'
        ) &&
        data.avgHeartRate is number && data.avgHeartRate >= 40 && data.avgHeartRate <= 240 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    function isValidMedicationItem(data, userId, medicationId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'dosage', 'frequency', 'scheduleTime',
          'instruction', 'takenToday', 'remainingPills', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'name', 'dosage', 'frequency', 'scheduleTime',
          'instruction', 'takenToday', 'remainingPills', 'updatedAt'
        ]) &&
        data.id is string && data.id == medicationId && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.dosage is string && data.dosage.size() >= 1 && data.dosage.size() <= 80 &&
        data.frequency is string && data.frequency.size() >= 1 && data.frequency.size() <= 80 &&
        data.scheduleTime is string && data.scheduleTime.size() >= 1 && data.scheduleTime.size() <= 16 &&
        data.instruction is string && data.instruction.size() >= 1 && data.instruction.size() <= 200 &&
        data.takenToday is bool &&
        data.remainingPills is number && data.remainingPills >= 0 && data.remainingPills <= 10000 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) && existing().uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        (
          // Action 1: Hydration update
          incoming().diff(existing()).affectedKeys().hasOnly(['waterIntakeMl', 'updatedAt']) ||
          // Action 2: Full profile sync
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'age', 'gender', 'heightCm', 'targetWeightKg',
            'bloodType', 'primaryDoctor', 'emergencyContact', 'dailyCalorieGoal',
            'dailyWaterGoalMl', 'dailyStepsGoal', 'dailySleepGoalHours',
            'waterIntakeMl', 'updatedAt'
          ])
        );
      allow delete: if isOwner(userId) && isValidId(userId) && existing().uid == request.auth.uid;

      // Subcollection 2: /users/{userId}/vitals/{vitalId}
      match /vitals/{vitalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(vitalId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(vitalId) &&
          isValidVitalRecord(incoming(), userId, vitalId) && hasValidParentProfile(userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(vitalId) &&
          isValidVitalRecord(incoming(), userId, vitalId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'time', 'systolic', 'diastolic', 'heartRate', 'spo2',
            'bloodGlucose', 'glucoseContext', 'weightKg', 'temperatureC',
            'sleepHours', 'steps', 'deviceSource', 'note', 'updatedAt'
          ]) &&
          hasValidParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(vitalId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
      }

      // Subcollection 3: /users/{userId}/meals/{mealId}
      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(mealId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(mealId) &&
          isValidMealEntry(incoming(), userId, mealId) && hasValidParentProfile(userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(mealId) &&
          isValidMealEntry(incoming(), userId, mealId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'time', 'mealType', 'foodName', 'calories',
            'proteinG', 'carbsG', 'fatG', 'updatedAt'
          ]) &&
          hasValidParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(mealId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
      }

      // Subcollection 4: /users/{userId}/workouts/{workoutId}
      match /workouts/{workoutId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workoutId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(workoutId) &&
          isValidWorkoutEntry(incoming(), userId, workoutId) && hasValidParentProfile(userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(workoutId) &&
          isValidWorkoutEntry(incoming(), userId, workoutId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'activityName', 'durationMinutes', 'caloriesBurned',
            'intensity', 'avgHeartRate', 'updatedAt'
          ]) &&
          hasValidParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(workoutId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
      }

      // Subcollection 5: /users/{userId}/medications/{medicationId}
      match /medications/{medicationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(medicationId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(medicationId) &&
          isValidMedicationItem(incoming(), userId, medicationId) && hasValidParentProfile(userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(medicationId) &&
          isValidMedicationItem(incoming(), userId, medicationId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          (
            // Action 1: Toggle daily adherence state
            incoming().diff(existing()).affectedKeys().hasOnly(['takenToday', 'remainingPills', 'updatedAt']) ||
            // Action 2: Full medication update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'dosage', 'frequency', 'scheduleTime',
              'instruction', 'takenToday', 'remainingPills', 'updatedAt'
            ])
          ) &&
          hasValidParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(medicationId) &&
          existing().userId == request.auth.uid && hasValidParentProfile(userId);
      }
    }
  }
}
